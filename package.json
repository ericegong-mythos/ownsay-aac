{
  "name": "ownsay-aac",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An open-source, local-first AAC web app with optional on-device language intelligence.",
  "license": "MIT",
  "author": "Eric Egong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericegong-mythos/ownsay-aac.git"
  },
  "bugs": {
    "url": "https://github.com/ericegong-mythos/ownsay-aac/issues"
  },
  "homepage": "https://github.com/ericegong-mythos/ownsay-aac#readme",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-sites-build.mjs && tsc -b && vite build",
    "preview": "vite preview --outDir dist/client",
    "test": "vitest",
    "test:run": "vitest run --exclude src/domain/real-model-gate.test.ts",
    "test:real-model": "vitest run src/domain/real-model-gate.test.ts",
    "test:e2e": "playwright test",
    "test:acceptance": "npm run test:run && npm run build && npm run test:e2e",
    "assert:public": "node scripts/assert-public-repo.mjs",
    "assert:bundle": "node scripts/assert-release-bundle.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.84",
    "lucide-react": "^0.525.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
